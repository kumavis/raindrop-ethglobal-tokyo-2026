{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Raindrop Design System — Trust-Weighted Token Issuance",
  "$version": "1.0.0",
  "color": {
    "$description": "Core palette — four primaries plus rose accent",
    "ink":       { "$value": "#1A3B52", "$type": "color", "$description": "Deep blue-slate — primary dark, text on light backgrounds" },
    "paper":     { "$value": "#DCF0FA", "$type": "color", "$description": "Pale sky — primary light, backgrounds, text on dark" },
    "rain":      { "$value": "#6AB8D8", "$type": "color", "$description": "Trust blue — the signature Raindrop color, accents, CTAs" },
    "amber":     { "$value": "#8DD4B7", "$type": "color", "$description": "Verdant mint — highlights, mission elements, secondary accent" },
    "rose":      { "$value": "#E8B5C7", "$type": "color", "$description": "Soft pink — iridescent accents, progress indicators, refraction hints" },
    "rose-mute": { "$value": "#F0D1DE", "$type": "color", "$description": "Muted rose — softer variant for backgrounds, subtle tints" }
  },
  "semantic": {
    "$description": "Semantic aliases — bind UI roles to palette tokens",
    "bg-primary":    { "$value": "{color.ink}",   "$type": "color", "$description": "Default dark background" },
    "bg-secondary":  { "$value": "{color.paper}", "$type": "color", "$description": "Light background, cards on dark" },
    "text-primary":  { "$value": "{color.paper}", "$type": "color", "$description": "Body text on dark backgrounds" },
    "text-on-light": { "$value": "{color.ink}",   "$type": "color", "$description": "Body text on light backgrounds" },
    "accent":        { "$value": "{color.rain}",  "$type": "color", "$description": "Primary accent — links, active states, focus rings" },
    "highlight":     { "$value": "{color.amber}", "$type": "color", "$description": "Secondary accent — tags, badges, success states" }
  },
  "spacing": {
    "$description": "Spacing scale — 8px base, geometric progression",
    "xs":  { "$value": "8px",   "$type": "dimension" },
    "sm":  { "$value": "16px",  "$type": "dimension" },
    "md":  { "$value": "24px",  "$type": "dimension" },
    "lg":  { "$value": "40px",  "$type": "dimension" },
    "xl":  { "$value": "64px",  "$type": "dimension" },
    "2xl": { "$value": "120px", "$type": "dimension" }
  },
  "radius": {
    "$description": "Border radius tokens",
    "sm":   { "$value": "12px",  "$type": "dimension", "$description": "Subtle rounding — cards, inputs" },
    "md":   { "$value": "24px",  "$type": "dimension", "$description": "Medium rounding — panels, modals" },
    "lg":   { "$value": "60px",  "$type": "dimension", "$description": "Large rounding — hero cards, featured sections" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "Full pill — buttons, tags, badges" }
  },
  "frame": {
    "$description": "Canonical frame dimensions (1080p presentation)",
    "width":  { "$value": "1920px", "$type": "dimension" },
    "height": { "$value": "1080px", "$type": "dimension" }
  },
  "typography": {
    "$description": "Type system — Manrope (display, geometric sans-serif) + Albert Sans (body, minimal sans-serif). Updated 2026-09-26: Cormorant replaced by Manrope",
    "font-family": {
      "display": { "$value": "Manrope",     "$type": "fontFamily", "$description": "Display and headline font — clean geometric modern sans-serif. Stack: 'Manrope', system-ui, -apple-system, sans-serif" },
      "body":    { "$value": "Albert Sans", "$type": "fontFamily", "$description": "Body, UI chrome, and secondary text — minimal geometric sans-serif. Stack: 'Albert Sans', system-ui, -apple-system, sans-serif" }
    },
    "display-hero": { "$description": "Primary hero display — largest heading tier", "font-family": { "$value": "{typography.font-family.display}" }, "font-weight": { "$value": "700" }, "font-size": { "$value": "120px" }, "line-height": { "$value": "95%" }, "letter-spacing": { "$value": "-2%" } },
    "display-heading": { "$description": "Beat/section headers", "font-family": { "$value": "{typography.font-family.display}" }, "font-weight": { "$value": "600" }, "font-size": { "$value": "100px" }, "line-height": { "$value": "95%" }, "letter-spacing": { "$value": "-2%" } },
    "hero-subtitle": { "$description": "Hero subtitles and large body", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "500" }, "font-size": { "$value": "58px" }, "line-height": { "$value": "120%" }, "letter-spacing": { "$value": "-1%" } },
    "display-title": { "$description": "Page/section title", "font-family": { "$value": "{typography.font-family.display}" }, "font-weight": { "$value": "600" }, "font-size": { "$value": "48px" }, "line-height": { "$value": "auto" }, "letter-spacing": { "$value": "0%" } },
    "body-large": { "$description": "Beat subtitles, paragraph text", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "400" }, "font-size": { "$value": "34px" }, "line-height": { "$value": "150%" }, "letter-spacing": { "$value": "1%" } },
    "body-default": { "$description": "Default body text", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "400" }, "font-size": { "$value": "18px" }, "line-height": { "$value": "140%" }, "letter-spacing": { "$value": "0%" } },
    "body-small": { "$description": "Captions, card body", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "400" }, "font-size": { "$value": "14px" }, "line-height": { "$value": "150%" }, "letter-spacing": { "$value": "0%" } },
    "dramatic-emphasis": { "$description": "Large italic accent text", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "400" }, "font-style": { "$value": "italic" }, "font-size": { "$value": "130px" }, "line-height": { "$value": "95%" }, "letter-spacing": { "$value": "-1%" } },
    "chrome-large": { "$description": "UI chrome, URLs, metadata — large", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "500" }, "font-size": { "$value": "32px" }, "line-height": { "$value": "150%" }, "letter-spacing": { "$value": "1%" } },
    "chrome-nav": { "$description": "Navigation labels, section markers", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "500" }, "font-size": { "$value": "28px" }, "line-height": { "$value": "150%" }, "letter-spacing": { "$value": "4%" }, "text-transform": { "$value": "uppercase" } },
    "chrome-small": { "$description": "Timestamps, small metadata", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "500" }, "font-size": { "$value": "22px" }, "line-height": { "$value": "150%" }, "letter-spacing": { "$value": "8%" }, "text-transform": { "$value": "uppercase" } },
    "specimen-label": { "$description": "Specimen/token labels (internal)", "font-family": { "$value": "{typography.font-family.body}" }, "font-weight": { "$value": "400" }, "font-size": { "$value": "16px" }, "line-height": { "$value": "auto" }, "letter-spacing": { "$value": "8%" }, "text-transform": { "$value": "uppercase" } },
    "button": { "$description": "Button / CTA labels", "font-family": { "$value": "{typography.font-family.display}" }, "font-weight": { "$value": "600" }, "font-size": { "$value": "18px" }, "line-height": { "$value": "auto" }, "letter-spacing": { "$value": "0%" } }
  },
  "glass": {
    "$description": "Frosted glass effect parameters",
    "fill-opacity":     { "matte": { "$value": "0.9" }, "translucent": { "$value": "0.45" } },
    "blur-radius":      { "background": { "$value": "20px" }, "orb": { "$value": "65px" } },
    "shadow":           { "edge-glow": { "$value": "24px" }, "rim-light": { "$value": "22px" }, "outer-glow": { "$value": "36px" }, "ambient-halo": { "$value": "48px" } },
    "iridescent-stops": { "0": { "$value": "{color.rain}" }, "20": { "$value": "{color.rose}" }, "40": { "$value": "#88E0E8" }, "60": { "$value": "{color.amber}" }, "80": { "$value": "#B8A9D4" }, "100": { "$value": "{color.rain}" } }
  },
  "progress-bar": {
    "$description": "Progress bar — rose by default, ink on light backgrounds. CSS: tokens/progress.css. Visual reference: reference/examples/progress-bar.svg",
    "height": { "$value": "6px", "$type": "dimension" },
    "radius": { "$value": "3px", "$type": "dimension" },
    "default":  { "$description": "Dark backgrounds (default)", "track": { "$value": "rgba(255,255,255,0.15)", "$type": "color" }, "fill": { "$value": "{color.rose}", "$type": "color" }, "glow": { "$value": "0 0 8px 1px rgba(232,181,199,0.4)", "$type": "shadow" } },
    "on-light": { "$description": "Light backgrounds", "track": { "$value": "rgba(26,59,82,0.15)", "$type": "color" }, "fill": { "$value": "{color.ink}", "$type": "color" }, "glow": { "$value": "none" } }
  },
  "components": {
    "$description": "Component inventory. width/height = component body; export-width/export-height = SVG canvas incl. glow padding. Exports carry no label text — overlay labels in code. See assets/README.md.",
    "beat-frame": { "width": 1920, "height": 1080 }, "chrome-overlay": { "width": 1920, "height": 1080 },
    "text-block": { "width": 666, "height": 168 }, "network-node": { "width": 62, "height": 104, "src@2x": "assets/components/network-node@2x.png", "$description": "PNG only (231×294 @2x); label ADA is baked in — needs SVG export without text" },
    "cta-button": { "width": 599, "height": 82 }, "mission-pill": { "width": 344, "height": 54 },
    "raindrop-icon": { "width": 94, "height": 109, "src": "assets/logo/raindrop-icon.svg", "src@2x": "assets/logo/raindrop-icon@2x.png", "$description": "CORE ICON — the Raindrop mark, primary brand icon. One of the two most-used visuals (with glass-circle-token)" },
    "ripple": { "width": 296, "height": 180, "export-width": 296, "export-height": 180, "src": "assets/components/ripple.svg", "src@2x": "assets/components/ripple@2x.png", "$description": "Ripple motif — raindrop impact rings" },
    "sybil-split": { "width": 296, "height": 180, "export-width": 296, "export-height": 180, "src": "assets/components/sybil-split.svg", "src@2x": "assets/components/sybil-split@2x.png", "$description": "Sybil split — one identity splitting into many fake accounts. Dark rounded panel is baked in. Use wherever Sybil attacks / Sybil resistance come up" },
    "sybil-stamp": { "width": 1125, "height": 166 },
    "cloud-background": { "width": 1920, "height": 1080, "src": "assets/backgrounds/cloud-background.png", "src@2x": "assets/backgrounds/cloud-background@2x.png" },
    "cloud-icon":                  { "width": 220, "height": 140, "export-width": 220, "export-height": 140, "src": "assets/components/cloud-icon.svg", "src@2x": "assets/components/cloud-icon@2x.png" },
    "cloud-icon-outline":          { "width": 231, "height": 154, "export-width": 231, "export-height": 154, "src": "assets/components/cloud-icon-outline.svg", "src@2x": "assets/components/cloud-icon-outline@2x.png" },
    "glass-circle-trust-halo":     { "width": 160, "height": 160, "export-width": 232, "export-height": 232, "src": "assets/components/glass-circle-trust-halo/trust-halo-light.svg", "src@2x": "assets/components/glass-circle-trust-halo/trust-halo-light@2x.png", "$description": "Light variant (default)" },
    "glass-circle-trust-halo-dark": { "width": 160, "height": 160, "export-width": 209, "export-height": 180, "src@2x": "assets/components/glass-circle-trust-halo/trust-halo-dark@2x.png", "$description": "Dark variant. PNG only (418×360 @2x, non-square, glow cropped); body size assumed same as light — needs square SVG export" },
    "glass-circle-token":          { "width": 56,  "height": 56,  "export-width": 98,  "export-height": 98,  "src": "assets/components/glass-circle-token.svg", "src@2x": "assets/components/glass-circle-token@2x.png", "src@3x": "assets/components/glass-circle-token@3x.png", "$description": "CORE ICON — the token, unit of value. One of the two most-used visuals (with raindrop-icon)" },
    "glass-pill-button-primary":   { "width": 126, "height": 54,  "export-width": 198, "export-height": 126, "src": "assets/components/glass-pill-button-primary.svg", "src@2x": "assets/components/glass-pill-button-primary@2x.png" },
    "glass-pill-button-secondary": { "width": 150, "height": 54,  "export-width": 222, "export-height": 126, "src": "assets/components/glass-pill-button-secondary.svg", "src@2x": "assets/components/glass-pill-button-secondary@2x.png" },
    "glass-pill-tag":              { "width": 98,  "height": 37,  "export-width": 142, "export-height": 81,  "src": "assets/components/glass-pill-tag.svg", "src@2x": "assets/components/glass-pill-tag@2x.png" },
    "glass-card":                  { "width": 360, "height": 123, "export-width": 432, "export-height": 195, "src": "assets/components/glass-card.svg", "src@2x": "assets/components/glass-card@2x.png" }
  }
}
